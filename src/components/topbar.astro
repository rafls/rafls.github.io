<div class="topbar" id="sustainability-topbar">
  <span class="topbar__text">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="topbar__bolt">
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
    </svg>
    Dark mode saves energy.
  </span>
  <button class="topbar__close" id="sustainability-topbar-close" aria-label="Dismiss" title="Dismiss">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
</div>

<script is:inline>
  (function () {
    var topbar = document.getElementById("sustainability-topbar");
    var closeBtn = document.getElementById("sustainability-topbar-close");
    if (!topbar || !closeBtn) return;
    if (localStorage.getItem("sustainability-topbar-dismissed")) {
      topbar.style.display = "none";
      return;
    }
    closeBtn.addEventListener("click", function () {
      topbar.style.display = "none";
      localStorage.setItem("sustainability-topbar-dismissed", "true");
    });
  })();
</script>
