---
import '@fontsource-variable/inter';
---

<div class="header">
  <div class="header__presentation">
    <a href="/" class="header__name"> Rafaela Silva <span class="header__role"> Product Owner </span> </a>
  </div>
  <div class="header__menu">
    <div class="header__actions">
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <button
        class="header__burger"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="header-mobile-navigation"
      >
        <svg class="header__burger-icon" width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M2 12.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5Zm0-4a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5Zm0-4a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5Z"/>
        </svg>
      </button>
    </div>
    <div class="header__navigation" id="header-mobile-navigation">
      <a href="/projects" class="header__casestudy"> Case studies </a>
      <a href="/images/rafls-resume-2026.pdf" class="header__resume">
        <span> Resume </span>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const header = document.querySelector(".header");
    const burgerButton = header?.querySelector(".header__burger");
    const navigationLinks = header?.querySelectorAll(".header__navigation a");

    if (!header || !burgerButton) return;

    // If this script runs more than once (e.g. View Transitions), avoid stacking
    // duplicate listeners — each click would fire twice and cancel the toggle.
    if (header.dataset.mobileNavBound === "true") return;
    header.dataset.mobileNavBound = "true";

    burgerButton.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = header.classList.toggle("header--menu-open");
      burgerButton.setAttribute("aria-expanded", String(isOpen));
    });

    navigationLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        header.classList.remove("header--menu-open");
        burgerButton.setAttribute("aria-expanded", "false");
      });
    });

    var themeToggle = document.querySelector(".theme-toggle");
    if (themeToggle) {
      if (themeToggle.dataset.bound === "true") return;
      themeToggle.dataset.bound = "true";

      themeToggle.addEventListener("click", function () {
        var html = document.documentElement;
        var current = html.getAttribute("data-theme");
        var next = current === "dark" ? "light" : "dark";
        html.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      });
    }
  })();
</script>
