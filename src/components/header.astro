---
import { Image } from 'astro:assets';
import arrow from '../../public/images/arrow-up-right-regular.svg';

import '@fontsource-variable/inter';
---

<div class="header">
  <div class="header__presentation">
    <a href="/" class="header__name"> Rafaela Silva <span class="header__role"> Product Owner & Designer </span> </a>
  </div>
  <div class="header__navigation">
    <a href="/projects"> Case studies </a>
    <a href="/rafls-resume.pdf">
      <button class="header__resume header__resume--scale">
        <span> Resume </span>
        <Image src={arrow} class="header__arrow" alt="arrow up right" />
      </button> 
    </a>
  </div>
</div>
