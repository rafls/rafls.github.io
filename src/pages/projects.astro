---
import Header from "../components/header.astro"
import Tags from "../components/tags.astro"
import { Image } from 'astro:assets';
import arrow from '../../public/images/arrow-up-right-regular.svg';

import stylesUrl from "../sass/index.scss?url"
import '@fontsource-variable/inter';
---

<!DOCTYPE html>
<html >
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, user-scalable=no" />
    <link rel="preload" href={stylesUrl} as="style">
    <link rel="stylesheet" href={stylesUrl}>
    <script type="text/javascript" src="../"></script>
  </head>
  <body>
    <div class="container">
      <Header />
      <div class="projects">
        <div class="projects__project">
          <a class="projects__identification" href="/submission">
            <p class="projects__header"> LoopOS Submission </p>
            <div class="projects__tags">
              <div><Tags text='UX/UI' outlined={true}/></div>
              <div><Tags text='Mobile' outlined={true}/></div>
              <div><Tags text='Sustainability' outlined={true}/></div>
              <div><Tags text='Circular economy' outlined={true}/></div>
            </div>
            <Image src={arrow} class="projects__arrow" alt="arrow up right" />
          </a>
        </div>

          <div class="projects__project">
            <a class="projects__identification" href="/capivara">
              <div class="projects__identification">
                <p class="projects__header"> Terra </p>
                <div class="projects__tags">
                  <div><Tags text='Graphic' outlined={true}/></div>
                  <div><Tags text='Visual Identity' outlined={true}/></div>
                  <div><Tags text='Events' outlined={true}/></div>
                  <div><Tags text='Culture' outlined={true}/></div>
                </div>
              </div>
              <Image src={arrow} class="projects__arrow" alt="arrow up right" />
            </a>
          </div>

