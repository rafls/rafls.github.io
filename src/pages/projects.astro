---
import Header from "../components/header.astro"
import Tags from "../components/tags.astro"

import stylesUrl from "../sass/index.scss?url"
import Footer from "../components/footer.astro";
---

<!DOCTYPE html>
<html >
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, user-scalable=no" />
    <link rel="preload" href={stylesUrl} as="style">
    <link rel="stylesheet" href={stylesUrl}>
    <script type="text/javascript" src="../"></script>
  </head>
  <body>
    <div>
      <Header />
      <div class="container">
        <div class="projects">

          <span class="text-gray" id="section-sustainability"> Sustainability </span>
          <div class="projects__project">
            <a class="projects__identification" href="/ai-form">
              <p class="projects__header"> AI-powered Form for Marketplace </p>
              <div class="projects__tags">
                <div><Tags text='Product' outlined={true}/></div>
                <div><Tags text='AI' outlined={true}/></div>
              <div><Tags text='2025' outlined={true}/></div>
              </div>
              <!-- <Image src={arrow} class="projects__arrow" alt="arrow up right" /> -->
            </a>
          </div>
        
          <div class="projects__project">
          <a class="projects__identification" href="/submission">
            <p class="projects__header"> LoopOS Submission </p>
            <div class="projects__tags">
              <div><Tags text='Product' outlined={true}/></div>
              <div><Tags text='Design' outlined={true}/></div>
              <div><Tags text='AI' outlined={true}/></div>
              <div><Tags text='2022-present' outlined={true}/></div>
            </div>
            <!-- <Image src={arrow} class="projects__arrow" alt="arrow up right" /> -->
          </a>
          </div>
          <br>
          <span class="text-gray" id="section-healthcare"> Portuguese Healthcare </span>
          
          <div class="projects__project">
          <a class="projects__identification" href="/anf">
            <p class="projects__header"> Vaccination Scheduling Platform for Pharmacies </p>
            <div class="projects__tags">
              <div><Tags text='UX/UI' outlined={true}/></div>
              <div><Tags text='Development' outlined={true}/></div>
              <div><Tags text='2021-2022' outlined={true}/></div>
            </div>
            <!-- <Image src={arrow} class="projects__arrow" alt="arrow up right" /> -->
          </a>
          </div>
          <div class="projects__project">
            <a class="projects__identification" href="/cvp">
              <p class="projects__header"> COVID-19 Testing Management Platform </p>
              <div class="projects__tags">
                <div><Tags text='UX/UI' outlined={true}/></div>
                <div><Tags text='2020' outlined={true}/></div>
              </div>
              <!-- <Image src={arrow} class="projects__arrow" alt="arrow up right" /> -->
            </a>
          </div>
        </div>
      </div>
    </div>
    <Footer />
  </body>
</html>