---
import Header from "../components/header.astro"
import Tags from "../components/tags.astro"
import Theme from "../components/theme.astro"

import stylesUrl from "../sass/index.scss?url"
import '@fontsource-variable/inter';
import Footer from "../components/footer.astro";
---

<!DOCTYPE html>
<html >
  <head>
    <Theme />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, user-scalable=no" />
    <link rel="preload" href={stylesUrl} as="style">
    <link rel="stylesheet" href={stylesUrl}>
    <script type="text/javascript" src="../"></script>
  </head>
  <body>
    <div>
      <Header />
      <div class="container">
        <div class="project">
          <div class="projects__identification margin-bottom-64">
            <p class="projects__header projects__header--scale">
              Vaccination Scheduling Platform for Pharmacies
            </p>
            <div class="projects__tags">
              <div><Tags text='UX/UI' outlined={true}/></div>
              <div><Tags text='Healthcare' outlined={true}/></div>
            </div>
          </div>
          <div class="project__main">
            <div class="project__nav">
              <div class="project__nav-list">
                <a href="#context" data-section="background">Context</a>
                <a href="#challenge" data-section="challenge">Challenge</a>
                <a href="#my-role" data-section="my-role">My Role</a>
                <a href="#solution" data-section="solution">Solution</a>
                <a href="#outcome" data-section="outcome">Outcome</a>
              </div>
            </div>
            <div class="project__content">
              <div class="project__case-study">
                <div class="project__introduction">
                  <span class="project__text"><span class="font-weight-medium">Role:</span> UI/UX Designer </span>
                  <span class="project__text"><span class="font-weight-medium">Timeline:</span> 2021-2022 </span>
                  <span class="project__text"><span class="font-weight-medium">Tools:</span> Figma, React </span>
                </div>
                <video controls>
                  <source src="/images/video-anf.mov" type="video/mp4" />
                </video>
                <div class="project__context">
                  <span class="project__subtitle" id="context"> Context </span>
                  <br>
                  <span class="project__section-content">
                  The portuguese pharmacies association needed a digital platform to schedule COVID-19, flu, and other vaccinations and services, allowing not only pharmacy staff to schelude but also patients.
                  </span>
                </div>

                <div class="project__challenge">
                  <span class="project__subtitle" id="challenge"> Challenge </span>
                  <div class="project__section-content">
                    <span>Design a scheduling experience that allowed pharmacies to:</span>
                    <ul>
                      <li class="project__list-item">Manage vaccination availability and capacity</li>
                      <li class="project__list-item">Schedule patients efficiently</li>
                      <li class="project__list-item">Maintain operational clarity throughout the day</li>
                    </ul>
                    <span>
                      The challenge was to balance simplicity for daily use with control over capacity and flow</span>.
                    </span>
                  </div>
                </div>

                <div class="project__role">
                  <span class="project__subtitle" id="my-role"> My Role </span>
                  <div class="project__section-content">
                    <span>As UX/UI Designer, I was responsible for:</span>
                    <ul>
                      <li>Designing the end-to-end scheduling experience</li>
                      <li>Structuring user flows for appointment creation and management</li>
                      <li>Defining information hierarchy for operational clarity</li>
                      <li>Designing interfaces focused on readability and consistency</li>
                      <li>Working directly with professionals from the Associação Nacional de Farmácias (ANF)</li>
                    </ul>
                  </div>
                </div>

                <div class="project__solution">
                  <span class="project__subtitle" id="solution"> Solution </span>
                  <div class="project__section-content">
                    <span>
                      The platform focused on clear scheduling logic and high visibility of availability</span>, with:
                    </span>
                    <ul>
                      <li>Straightforward appointment creation and management</li>
                      <li>Clear representation of available and occupied slots</li>
                      <li>Interfaces designed to reduce ambiguity and operational errors</li>
                    </ul>
                    <span>
                      Design decisions prioritized clarity and repeatability across different pharmacy contexts.
                    </span>
                  </div>
                </div>

                <div class="project__outcome">
                  <span class="project__subtitle" id="outcome"> Outcome </span>
                  <div class="project__section-content">
                    <ul>
                      <li class="project__list-item">Adopted by Portuguese pharmacies to support vaccination campaigns</li>
                      <li class="project__list-item">Enabled a standardized scheduling process across multiple locations</li>
                      <li class="project__list-item">Supported large-scale public health operations through a consistent UX</li>
                      <li class="project__list-item">Still currently operating in Portugal. Check it <a href="https://agendamento.farmaciasportuguesas.pt/" target="_blank" class="project__text">here</a>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="project__navigation">
                <a href="/submission" class="project__nav-link--prev">← LoopOS Submission</a>
                <a href="/cvp" class="project__nav-link--next">COVID-19 Testing Platform →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <Footer />
  </body>
</html>