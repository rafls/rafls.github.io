<!DOCTYPE html>
<html >
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, user-scalable=no" />
    <link rel="preload" href={stylesUrl} as="style">
    <link rel="stylesheet" href={stylesUrl}>
    <script type="text/javascript" src="../"></script>
  </head>
  <body>
    <div class="container">
      <Header />
      <div class="project">
        <div class="projects__identification margin-bottom-48">
          <p class="projects__header"> Terra </p>
          <div class="projects__tags">
            <div><Tags text='Graphic' outlined={true}/></div>
            <div><Tags text='Visual Identity' outlined={true}/></div>
            <div><Tags text='Events' outlined={true}/></div>
            <div><Tags text='Culture' outlined={true}/></div>
          </div>
        </div>
        <div class="project__content">
          <div class="project__case-study">
            <div class="project__introduction">
              <span class="project__text"><span class="font-weight-medium">Role:</span> Graphic Designer</span>
              <span class="project__text"><span class="font-weight-medium">Date:</span> 2021 </span>
              <span class="project__text"><span class="font-weight-medium">Tools:</span> Adobe Illustrator </span>
            </div>
            <br>
            <!--problem statement -->
            <div class="display-column">
              <span class="project__text"> 
                TERRA was a world music programming cycle promoted by Capivara Azul - in dialogue with the permanent collection of the Centro Internacional das Artes José de Guimarães, in Guimarães. This cycle of events needed a visual identity to create media and print materials, ensuring a cohesive and recognizable presence across all promotional platforms and supporting materials.
              </span>
            </div>
