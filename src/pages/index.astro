---

import Footer from "../components/footer.astro"
import Header from "../components/header.astro"
import Tags from "../components/tags.astro"
import Image from "astro/components/Image.astro"
import sustainability from '../../public/images/sustainability.png';
import healthcare from '../../public/images/healthcare.png';
import initial from '../../public/images/home-mockup.png';


import stylesUrl from "../sass/index.scss?url"
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
---

