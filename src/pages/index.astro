  <body>
    <div>
      <Header />
      <div class="container">
      <div class="home">
        <div class="home__top">
          <div class="home__introduction"> 
            <div class="home__introduction--top">
              <div class="home__tags">
                <!-- <div>
                  <Tags text='🌍 Open to relocate' outlined={true} />
                </div> -->
                <div>
                  <Tags text='🌍 +3M users impacted' outlined={true} />
                </div>
                <div>
                  <Tags text='🩺 Healthcare and Sustainability' outlined={true} />
                </div>
              </div>
            </div>
              <div class="home__role"> I guide teams to execute and ship products <span style="font-family:'DM Sans'" class="text-dark-gray"> that matter in the real world. </span> </div>    
          </div>
          <div class="home__project-images">
