              <a href="/projects#section-sustainability">
                <Image src={sustainability} class="project__image-large" alt="Sustainability" />
              </a>
            </div>
            
            <div class="home__project-image">
              <div class="project__image-large">
                <a href="/projects#section-healthcare">
                  <Image src={healthcare} class="project__image-large" alt="Healthcare" />
                </a>
