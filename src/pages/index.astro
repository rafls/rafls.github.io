            <div class="home__project-image">
              <div class="project__image-large">
                <a href="/projects#section-submission">
                  <Image src={initial} class="project__image-large" alt="LoopOS Submission" />
                </a>
                <span class="home__project-image-text"> LoopOS Submission </span>
              </div>
            </div>
          </div>
          </div>
        </div>
      </div>
    </div>
    <Footer />
  </body>
</html>
