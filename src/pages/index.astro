---
import Footer from "../components/footer.astro"
import Header from "../components/header.astro"
import Tags from "../components/tags.astro"

import stylesUrl from "../sass/index.scss?url"
import '@fontsource-variable/inter';
---
<!DOCTYPE html>
<html>
  <head>
    <title>RS UX·UI</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, user-scalable=no" />
    <link rel="preload" href={stylesUrl} as="style">
    <link rel="stylesheet" href={stylesUrl}>
    <script type="text/javascript" src="../"></script>
  </head>
  <body>
    <div class="container">
      <Header />
      <div class="home">
        <div class="home__top">
          <div class="home__presentation-top">
            <div class="home__introduction">
              <div class="home__introduction--top">
                <div class="home__tags">
                  <div>
                    <Tags text='✍🏻 5 years of experience' outlined={true}/>
                  </div>
                  <div>
                    <Tags text='🌍 Open to move aboard' outlined={true} />
                  </div>
                </div>
              </div>
              <span class="home__text">
                UX·UI Designer and Frontend developer <br />
                focused on
                <span class="home__text-highlight"> health </span> and
                <span class="home__text-highlight"> sustainability </span>
                <br />
                projects and innovation.
              </span>
            </div>
          </div>
          <div class="home__presentation-bottom">
            <div class="home__tags">
              <div>
                <Tags text='Figma' outlined={true} />
              </div>
              <div>
                <Tags text='HTML' outlined={true} />
              </div>
              <div>
                <Tags text='CSS/SASS' outlined={true} />
              </div>
              <div>
                <Tags text='Tailwind' outlined={true} />
              </div>
              <div>
                <Tags text='React' outlined={true} />
              </div>
              <div>
                <Tags text='Ruby on Rails' outlined={true} />
              </div>
              <div>
                <Tags text='Git' outlined={true} />
              </div>
            </div>
          </div>
        </div>
      </div>
      <Footer />
    </div>
  </body>
</html>