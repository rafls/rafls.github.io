---
import Header from "../components/header.astro"
import Tags from "../components/tags.astro"

import stylesUrl from "../sass/index.scss?url"
import '@fontsource-variable/inter';
import Footer from "../components/footer.astro";
---

<!DOCTYPE html>
<html >
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, user-scalable=no" />
    <link rel="preload" href={stylesUrl} as="style">
    <link rel="stylesheet" href={stylesUrl}>
    <script type="text/javascript" src="../"></script>
  </head>
  <body>
    <div>
      <Header />
      <div class="container">
        <div class="project">
          <div class="projects__identification margin-bottom-64">
            <p class="projects__header projects__header--scale"> COVID-19 Testing Management Platform </p>
            <div class="projects__tags">
              <div><Tags text='UX/UI' outlined={true}/></div>
              <div><Tags text='Healthcare' outlined={true}/></div>
            </div>
          </div>
          <div class="project__main">
            <div class="project__nav">
             <div class="project__nav-list">
              <a href="#context" data-section="context">Context</a>
              <a href="#design-challenge" data-section="design-challenge">Design Challenge</a>
              <a href="#my-role" data-section="my-role">My Role</a>
              <a href="#solution" data-section="solution">Solution</a>
              <a href="#outcome" data-section="outcome">Outcome</a>
              </div>
            </div>
            <div class="project__content">
              <div class="project__case-study">
                <div class="project__introduction">
                  <span class="project__text"><span class="font-weight-medium">Role:</span> UI/UX Designer </span>
                  <span class="project__text"><span class="font-weight-medium">Timeline:</span> 2020 </span>
                  <span class="project__text"><span class="font-weight-medium">Tools:</span> Figma </span>
                </div>
                <div class="project__context">
                  <span class="project__subtitle" id="context"> Context </span>
                  <br>
                  <span class="project__section-content"> During the COVID-19 pandemic, healthcare services required a digital platform to manage the full testing workflow - from appointment scheduling to patient admission and results tracking - in a high-demand public health scenario. </span>
                </div>

                <div class="project__challenge">
                  <span class="project__subtitle" id="design-challenge"> Design Challenge </span>
                  <div class="project__section-content">
                    <span>Design a system that enabled healthcare professionals to:</span>
                    <ul>
                      <li class="project__list-item">Manage appointments and testing capacity clearly</li>
                      <li class="project__list-item">Admit patients efficiently and consistently</li>
                      <li class="project__list-item">Monitor operational status at a glance</li>
                    </ul>
                    <span>
                      The interface needed to support fast decision-making while minimizing errors.
                    </span>
                  </div>
                </div>

                <div class="project__role">
                  <span class="project__subtitle" id="my-role"> My Role </span>
                  <div class="project__section-content">
                    <span>As UX/UI Designer, I was responsible for:</span>
                    <ul>
                      <li>Designing the end-to-end user experience</li>
                      <li>Structuring the operational flow (admission → payment → sample → result)</li>
                      <li>Defining information hierarchy and visual priorities</li>
                      <li>Designing dashboards focused on data readability</li>
                      <li>Working directly with healthcare professionals to validate flows and screens</li>
                    </ul>
                  </div>
                </div>

                <div class="project__solution">
                  <span class="project__subtitle" id="solution"> Solution </span>
                  <div class="project__section-content">
                    <span>
                      The platform was built around guided, sequential flows and highly readable operational data, including:
                    </span>
                    <ul>
                      <li>Percentage of daily capacity usage</li>
                      <li>Available appointment slots</li>
                      <li>Number of tests pending results</li>
                    </ul>
                    <span>
                      A visual dashboard allowed professionals to quickly assess system status and take action, while step-by-step screens supported patient admission and processing.
                    </span>
                  </div>
                </div>

                <div class="project__outcome">
                  <span class="project__subtitle" id="outcome"> Outcome </span>
                  <div class="project__section-content">
                    <ul>
                      <li class="project__list-item">Adopted by the Cruz Vermelha Portuguesa for COVID-19 testing operations</li>
                      <li class="project__list-item">The same system was later adapted and widely used by Farmácias Portuguesas</li>
                      <li class="project__list-item">Enabled consistent workflows across multiple healthcare locations</li>
                      <li class="project__list-item"> +3M users impacted</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <Footer />
  </body>
</html>
